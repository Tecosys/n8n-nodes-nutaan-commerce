{
  "name": "n8n-nodes-nutaan-commerce",
  "version": "0.1.0",
  "description": "Nutaan Commerce cart recovery, COD verification, delivery assistance and returns for n8n",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "nutaan",
    "commerce"
  ],
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "n8n-node build",
    "test": "node --test tests/*.test.cjs",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.52.3",
    "@types/node": "^22.0.0",
    "n8n-workflow": "2.16.0",
    "typescript": "^5.9.3"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/NutaanCommerceApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/NutaanCommerce/NutaanCommerce.node.js",
      "dist/nodes/NutaanCommerceTrigger/NutaanCommerceTrigger.node.js"
    ]
  },
  "author": {
    "name": "Tecosys",
    "email": "avishek@nutaan.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tecosys/n8n-nodes-nutaan-commerce.git"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "homepage": "https://nutaan.com/nutaan-commerce"
}
